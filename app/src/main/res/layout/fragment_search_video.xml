<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color_dd"
    xmlns:app="http://schemas.android.com/apk/res-auto">

   <RelativeLayout
       android:id="@+id/topView"
       app:layout_constraintTop_toTopOf="parent"
       android:layout_width="match_parent"
       android:paddingRight="10dp"
       android:paddingLeft="10dp"
       android:layout_height="wrap_content">

      <androidx.appcompat.widget.AppCompatImageButton
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_margin="5dp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintLeft_toLeftOf="parent"
          android:src="@drawable/ic_baseline_arrow_back_24"
          style="@style/AppTheme.TransperentSquer.ImageButton"
          android:id="@+id/backPrease"
          tools:ignore="MissingConstraints" />
      <androidx.appcompat.widget.AppCompatEditText
          android:id="@+id/searchText"
          android:selectAllOnFocus="true"
          android:layout_width="match_parent"
          android:padding="5dp"
          android:layout_margin="5dp"
          android:background="@drawable/search_edit_text_background"
          android:layout_toRightOf="@id/backPrease"
          android:layout_height="wrap_content"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintLeft_toLeftOf="@id/backPrease"
          tools:ignore="MissingConstraints" />

   </RelativeLayout>

   <androidx.recyclerview.widget.RecyclerView
       android:layout_width="match_parent"
       android:layout_height="0dp"
      app:layout_constraintTop_toBottomOf="@id/topView"
      app:layout_constraintBottom_toBottomOf="parent"
      android:id="@+id/viewItem"/>

</androidx.constraintlayout.widget.ConstraintLayout>