<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:elevation="0dp"
    android:layout_marginLeft="8dp"
    android:background="@drawable/video_item_background"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="2dp">






    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_marginRight="8dp"
        android:layout_height="200dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/videoImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_centerInParent="true"
            android:layout_marginStart="0dp"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginRight="0dp"
            android:layout_marginBottom="0dp"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:src="@drawable/image_1"
            app:shapeAppearanceOverlay="@style/roundedImageView">

        </com.google.android.material.imageview.ShapeableImageView>

        <TextView
            android:drawableLeft="@drawable/ic_baseline_access_time_24_black_white"
            android:drawableTint="@color/white"
            android:drawablePadding="2dp"
            android:id="@+id/duration"
            style="@style/roundedImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignRight="@id/videoImage"
            android:layout_alignBottom="@id/videoImage"
            android:layout_marginStart="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/black"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="3:15"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </RelativeLayout>


            <RelativeLayout
                android:layout_width="match_parent"
                android:gravity="bottom"
                android:layout_gravity="bottom"
                android:id="@+id/dd"
                android:layout_height="wrap_content">


                <TextView
                    android:id="@+id/VideoTitel"
                    style="@style/TextAppearance.AppCompat.Body1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@id/VideoMore"
                    android:gravity="bottom"
                    android:maxLines="2"
                    android:text=" Video Title video title video title video"
                    android:textStyle="normal" />

                <ImageButton
                    android:id="@+id/VideoMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    style="@style/AppTheme.TransperentCircule.ImageButton"
                    app:srcCompat="@drawable/ic_baseline_more_vert_24"
                    tools:ignore="VectorDrawableCompat" />


                <TextView
                    android:id="@+id/VideoBody"
                    style="@style/TextAppearance.AppCompat.Body1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/VideoTitel"
                    android:drawableLeft="@drawable/ic_baseline_folder_24"
                    android:drawablePadding="4dp"
                    android:maxLines="1"
                    android:text="Folder Name"
                    android:textColor="@color/black_white" />


            </RelativeLayout>






</LinearLayout>